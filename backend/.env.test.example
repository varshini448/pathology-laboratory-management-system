# Copy to .env.test and use credentials for a local/disposable MongoDB instance.
# The URI path must name exactly pathology_laboratory_test.
MONGO_TEST_URI=mongodb://127.0.0.1:27017/pathology_laboratory_test
# Generate a unique secret for this test environment; never reuse production JWT_SECRET.
JWT_SECRET=replace-with-a-long-random-test-only-secret
RUN_MONGO_INTEGRATION=true
ALLOW_TEST_DB_RESET=true
